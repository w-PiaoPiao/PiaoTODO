#!/bin/sh
# Gradle wrapper that uses the system-installed Gradle
# If you have Gradle installed via Homebrew, this will use it.
# Otherwise, set GRADLE_HOME to your Gradle installation directory.

if [ -n "$GRADLE_HOME" ]; then
  GRADLE_CMD="$GRADLE_HOME/bin/gradle"
elif command -v gradle >/dev/null 2>&1; then
  GRADLE_CMD="gradle"
else
  echo "Gradle not found. Install it via Homebrew: brew install gradle"
  echo "Or set GRADLE_HOME to your Gradle installation directory."
  exit 1
fi

exec $GRADLE_CMD "$@"
